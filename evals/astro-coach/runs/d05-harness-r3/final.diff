+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+// Regression guard for defect 05: Sonnet 5 rejects assistant-message prefill
+// (a trailing { role: "assistant" } turn) with a 400. generateDashaPrediction
+// used to prefill "{", so every dasha prediction request failed.
+
+const create = vi.fn();
+vi.mock("@anthropic-ai/sdk", () => ({
+  default: class {
+    messages = { create, stream: vi.fn() };
+  },
+}));
+vi.mock("@/lib/llm-usage", () => ({
+  recordLlmUsage: vi.fn(),
+  createStreamUsageTracker: vi.fn(),
+}));
+
+describe("no assistant prefill", () => {
+  beforeEach(() => create.mockReset());
+
+  it("lib/claude.ts never sends a literal assistant turn", () => {
+    const src = readFileSync(join(process.cwd(), "lib/claude.ts"), "utf8");
+    expect(src).not.toMatch(/role:\s*["']assistant["']/);
+  });
+
+  it("generateDashaPrediction sends only the user turn and returns the reply text", async () => {
+    const { generateDashaPrediction } = await import("@/lib/claude");
+    const body = '{"themes":["a"],"cultivate":["b"],"challenges":["c"],"actions":["d"],"summary":"e"}';
+    create.mockResolvedValue({
+      content: [{ type: "text", text: body }],
+      stop_reason: "end_turn",
+      usage: {},
+    });
+
+    const out = await generateDashaPrediction("prompt");
+
+    const params = create.mock.calls[0][0];
+    expect(params.messages).toEqual([{ role: "user", content: "prompt" }]);
+    expect(out).toBe(body);
+    expect(JSON.parse(out).summary).toBe("e");
+  });
+
+  it("generateDashaPrediction reports truncation clearly", async () => {
+    const { generateDashaPrediction } = await import("@/lib/claude");
+    create.mockResolvedValue({
+      content: [{ type: "text", text: '{"themes":["a"' }],
+      stop_reason: "max_tokens",
+      usage: {},
+    });
+    await expect(generateDashaPrediction("prompt")).rejects.toThrow(/truncated/);
+  });
+});
