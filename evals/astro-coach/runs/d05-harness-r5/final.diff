+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+// User report: "dasha predictions show an error". generateDashaPrediction ended
+// its messages on an assistant prefill ("{"), which Sonnet 5 rejects, so every
+// /api/dasha call failed with a 500.
+const create = vi.fn();
+vi.mock("@anthropic-ai/sdk", () => ({
+  default: class {
+    messages = { create };
+  },
+}));
+vi.mock("@/lib/llm-usage", () => ({
+  recordLlmUsage: vi.fn(),
+  createStreamUsageTracker: vi.fn(),
+}));
+
+import { generateDashaPrediction } from "@/lib/claude";
+import { prepareJsonString } from "@/lib/claude-json";
+
+const reply = (text: string, stop_reason = "end_turn") => ({
+  content: [{ type: "text", text, citations: null }],
+  stop_reason,
+  usage: { input_tokens: 1, output_tokens: 1 },
+});
+
+describe("generateDashaPrediction", () => {
+  beforeEach(() => create.mockReset());
+
+  it("ends the conversation on a user turn (no assistant prefill)", async () => {
+    create.mockResolvedValue(reply('{"summary": "ok"}'));
+    await generateDashaPrediction("prompt");
+    const params = create.mock.calls[0][0];
+    expect(params.messages.at(-1).role).toBe("user");
+    expect(params.messages.some((m: { role: string }) => m.role === "assistant")).toBe(false);
+    expect(params.thinking).toEqual({ type: "disabled" });
+  });
+
+  it("returns a reply the route can parse as the full JSON object", async () => {
+    const json = '{"themes": ["a"], "cultivate": ["b"], "challenges": ["c"], "actions": ["d"], "summary": "e"}';
+    create.mockResolvedValue(reply(json));
+    const raw = await generateDashaPrediction("prompt");
+    expect(JSON.parse(prepareJsonString(raw))).toEqual(JSON.parse(json));
+  });
+
+  it("names a truncated reply instead of returning half a JSON document", async () => {
+    create.mockResolvedValue(reply('{"themes": ["a', "max_tokens"));
+    await expect(generateDashaPrediction("prompt")).rejects.toThrow(/Dasha prediction reply truncated/);
+  });
+});
