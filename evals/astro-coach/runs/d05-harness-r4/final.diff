+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+// Sonnet 5 rejects assistant-message prefill (a trailing assistant turn) with
+// a 400. The dasha prediction call used to prefill "{" and broke every
+// prediction request after the model upgrade.
+describe("Claude calls do not prefill the assistant turn", () => {
+  const src = readFileSync(join(process.cwd(), "lib/claude.ts"), "utf8");
+
+  it("no hardcoded assistant message in any request", () => {
+    expect(src).not.toMatch(/role:\s*["']assistant["']/);
+  });
+
+  it("dasha prediction does not re-prepend a prefill brace", () => {
+    const fn = src.slice(src.indexOf("export async function generateDashaPrediction"));
+    const body = fn.slice(0, fn.indexOf("\n}\n"));
+    expect(body).toContain("messages: [{ role: \"user\", content: prompt }]");
+    expect(body).not.toMatch(/["']\{["']\s*\+/);
+  });
+});
