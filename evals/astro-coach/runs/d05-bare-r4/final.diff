@@ -0,0 +1,38 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+// Current Claude models reject an assistant-prefill turn (400), which made every
+// dasha prediction fail. Guard that the request ends with the user turn and that
+// the model's full JSON reply is returned unmodified.
+const create = vi.fn();
+vi.mock("@anthropic-ai/sdk", () => ({
+  default: class {
+    messages = { create };
+  },
+}));
+vi.mock("@/lib/llm-usage", () => ({
+  recordLlmUsage: vi.fn(),
+  createStreamUsageTracker: vi.fn(),
+}));
+
+import { generateDashaPrediction } from "@/lib/claude";
+
+describe("generateDashaPrediction", () => {
+  beforeEach(() => create.mockReset());
+
+  it("sends no assistant prefill and returns the reply as-is", async () => {
+    const reply = '{"themes":["a"],"cultivate":["b"],"challenges":["c"],"actions":["d"],"summary":"s"}';
+    create.mockResolvedValue({
+      content: [{ type: "text", text: reply }],
+      stop_reason: "end_turn",
+      usage: { input_tokens: 1, output_tokens: 1 },
+    });
+
+    const out = await generateDashaPrediction("prompt");
+
+    const params = create.mock.calls[0][0];
+    expect(params.messages.at(-1).role).toBe("user");
+    expect(params.messages.some((m: { role: string }) => m.role === "assistant")).toBe(false);
+    expect(out).toBe(reply);
+    expect(JSON.parse(out).summary).toBe("s");
+  });
+});
