+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const create = vi.fn();
+
+vi.mock("@anthropic-ai/sdk", () => ({
+  default: class {
+    messages = { create };
+  },
+}));
+
+vi.mock("@/lib/llm-usage", () => ({
+  recordLlmUsage: vi.fn(),
+  createStreamUsageTracker: vi.fn(),
+}));
+
+import { generateDashaPrediction } from "@/lib/claude";
+import { prepareJsonString } from "@/lib/claude-json";
+
+const reply = {
+  themes: ["a"],
+  cultivate: ["b"],
+  challenges: ["c"],
+  actions: ["d"],
+  summary: "e",
+};
+
+describe("generateDashaPrediction request shape", () => {
+  beforeEach(() => {
+    create.mockReset();
+    create.mockResolvedValue({
+      content: [{ type: "text", text: JSON.stringify(reply, null, 2) }],
+      stop_reason: "end_turn",
+      usage: { input_tokens: 1, output_tokens: 1 },
+    });
+  });
+
+  it("does not send an assistant prefill (rejected by current Claude models)", async () => {
+    await generateDashaPrediction("prompt");
+    const params = create.mock.calls[0][0] as { messages: { role: string }[] };
+    expect(params.messages.at(-1)?.role).toBe("user");
+    expect(params.messages.some((m) => m.role === "assistant")).toBe(false);
+  });
+
+  it("returns the model's JSON unmodified so the route can parse it", async () => {
+    const raw = await generateDashaPrediction("prompt");
+    expect(JSON.parse(prepareJsonString(raw))).toEqual(reply);
+  });
+
+  it("still parses when the model wraps the JSON in a code fence", async () => {
+    create.mockResolvedValueOnce({
+      content: [{ type: "text", text: "```json\n" + JSON.stringify(reply) + "\n```" }],
+      stop_reason: "end_turn",
+      usage: { input_tokens: 1, output_tokens: 1 },
+    });
+    const raw = await generateDashaPrediction("prompt");
+    expect(JSON.parse(prepareJsonString(raw))).toEqual(reply);
+  });
+});
