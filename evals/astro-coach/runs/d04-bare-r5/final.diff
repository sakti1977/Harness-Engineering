+import { describe, it, expect } from "vitest";
+import { extractJsonObject } from "./claude-json";
+
+describe("extractJsonObject — long multi-line replies", () => {
+  it("parses a pretty-printed reply with CRLF line endings and multi-line string values", () => {
+    const raw =
+      "Here is your plan:\r\n```json\r\n{\r\n\t\"plan\": [\r\n\t\t{\r\n\t\t\t\"step\": \"Wake early\nand meditate\",\r\n\t\t\t\"days\": 7\r\n\t\t}\r\n\t],\r\n\t\"note\": \"Be \\\"patient\\\"\"\r\n}\r\n```\r\n";
+    expect(extractJsonObject(raw)).toEqual({
+      plan: [{ step: "Wake early\nand meditate", days: 7 }],
+      note: 'Be "patient"',
+    });
+  });
+
+  it("does not alter structural whitespace after a string ending in an escaped backslash", () => {
+    const raw = '{\n  "path": "C:\\\\",\n  "ok": true\n}';
+    expect(extractJsonObject(raw)).toEqual({ path: "C:\\", ok: true });
+  });
+});
