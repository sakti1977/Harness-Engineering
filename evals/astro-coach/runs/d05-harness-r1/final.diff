+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const create = vi.fn();
+vi.mock("@anthropic-ai/sdk", () => ({
+  default: class {
+    messages = { create };
+  },
+}));
+vi.mock("@/lib/llm-usage", () => ({
+  recordLlmUsage: vi.fn(),
+  createStreamUsageTracker: vi.fn(),
+}));
+
+import { generateDashaPrediction } from "@/lib/claude";
+import { prepareJsonString } from "@/lib/claude-json";
+
+// Regression: Sonnet 5 rejects assistant-message prefill with a 400, which made
+// every "open a dasha period" prediction show an error.
+describe("generateDashaPrediction", () => {
+  beforeEach(() => create.mockReset());
+
+  it("does not send an assistant prefill and returns the model's JSON intact", async () => {
+    const json = '{"themes":["a"],"cultivate":["b"],"challenges":["c"],"actions":["d"],"summary":"e"}';
+    create.mockResolvedValue({ content: [{ type: "text", text: json }], stop_reason: "end_turn", usage: {} });
+
+    const raw = await generateDashaPrediction("prompt");
+
+    const args = create.mock.calls[0][0] as { messages: { role: string }[] };
+    expect(args.messages.at(-1)?.role).toBe("user");
+    expect(args.messages.some((m) => m.role === "assistant")).toBe(false);
+    expect(JSON.parse(prepareJsonString(raw))).toEqual(JSON.parse(json));
+  });
+});
