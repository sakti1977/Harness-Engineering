+import { describe, it, expect } from "vitest";
+import { extractJsonObject, prepareJsonString } from "./claude-json";
+
+describe("extractJsonObject — long multi-line coaching replies", () => {
+  it("parses a long, fenced, pretty-printed reply with multi-line string values", () => {
+    const raw = [
+      "Here is your coaching plan:",
+      "```json",
+      "{",
+      '  "summaryObservations": [',
+      "    {",
+      '      "text": "You tend to postpone hard conversations.\nThis shows up at work\r\nand at home.",',
+      '      "category": "pattern"',
+      "    },",
+      "    {",
+      '      "text": "Morning routine:\n\t1. meditate\n\t2. journal",',
+      '      "category": "practice"',
+      "    }",
+      "  ],",
+      '\t"shouldTransitionToRecommending": true',
+      "}",
+      "```",
+    ].join("\n");
+
+    expect(extractJsonObject(raw)).toEqual({
+      summaryObservations: [
+        {
+          text: "You tend to postpone hard conversations.\nThis shows up at work\r\nand at home.",
+          category: "pattern",
+        },
+        { text: "Morning routine:\n\t1. meditate\n\t2. journal", category: "practice" },
+      ],
+      shouldTransitionToRecommending: true,
+    });
+  });
+
+  it("handles CRLF line endings between tokens", () => {
+    const raw = '{\r\n  "a": 1,\r\n  "b": "x"\r\n}';
+    expect(extractJsonObject(raw)).toEqual({ a: 1, b: "x" });
+  });
+
+  it("preserves an escaped backslash before a closing quote", () => {
+    const raw = '{\n  "path": "C:\\\\dir\\\\",\n  "n": 1\n}';
+    expect(JSON.parse(prepareJsonString(raw))).toEqual({ path: "C:\\dir\\", n: 1 });
+  });
+});
diff --git a/astro-coach/lib/claude-json.ts b/astro-coach/lib/claude-json.ts
index 15bf4e0..903e694 100644
--- a/astro-coach/lib/claude-json.ts
+++ b/astro-coach/lib/claude-json.ts
@@ -32,10 +32,52 @@ export function prepareJsonString(raw: string): string {
   // Remove stray C0/C1 control characters while preserving \n \t \r
   jsonStr = jsonStr.replace(/[\x00-\x08\x0B-\x0C\x0E-\x1F\x7F]/g, " ");
 
-  // Escape bare (un-escaped) newlines and tabs so JSON.parse doesn't choke
-  jsonStr = jsonStr.replace(/(?<!\\)\n/g, "\\n").replace(/(?<!\\)\t/g, "\\t");
+  // Escape raw newlines / CRs / tabs that appear *inside string literals* so
+  // JSON.parse doesn't choke. Whitespace between tokens (pretty-printed JSON)
+  // must be left untouched — escaping it produces invalid JSON.
+  return escapeControlCharsInStrings(jsonStr);
+}
+
+/**
+ * Walk the JSON text tracking whether we are inside a string literal, and
+ * escape raw \n, \r and \t only there. Structural whitespace is preserved.
+ */
+function escapeControlCharsInStrings(json: string): string {
+  let out = "";
+  let inString = false;
+  let escaped = false;
+
+  for (const ch of json) {
+    if (!inString) {
+      if (ch === '"') inString = true;
+      out += ch;
+      continue;
+    }
+
+    if (escaped) {
+      escaped = false;
+      out += ch;
+      continue;
+    }
+
+    if (ch === "\\") {
+      escaped = true;
+      out += ch;
+    } else if (ch === '"') {
+      inString = false;
+      out += ch;
+    } else if (ch === "\n") {
+      out += "\\n";
+    } else if (ch === "\r") {
+      out += "\\r";
+    } else if (ch === "\t") {
+      out += "\\t";
+    } else {
+      out += ch;
+    }
+  }
 
-  return jsonStr;
+  return out;
 }
 
