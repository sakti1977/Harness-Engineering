+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const create = vi.fn();
+vi.mock("@anthropic-ai/sdk", () => ({
+  default: class {
+    messages = { create };
+  },
+}));
+vi.mock("@/lib/llm-usage", () => ({
+  recordLlmUsage: vi.fn(),
+  createStreamUsageTracker: vi.fn(),
+}));
+
+import { generateDashaPrediction } from "@/lib/claude";
+
+// Current Claude models reject requests whose last message is an assistant
+// prefill with a 400, which surfaced as "Dasha prediction failed" for users.
+describe("generateDashaPrediction", () => {
+  beforeEach(() => create.mockReset());
+
+  it("does not send an assistant prefill and returns the model text as-is", async () => {
+    create.mockResolvedValue({
+      content: [{ type: "text", text: '{"summary":"ok"}' }],
+      stop_reason: "end_turn",
+      usage: {},
+    });
+    const out = await generateDashaPrediction("prompt");
+    const params = create.mock.calls[0][0];
+    expect(params.messages.at(-1).role).toBe("user");
+    expect(params.messages.some((m: { role: string }) => m.role === "assistant")).toBe(false);
+    expect(JSON.parse(out)).toEqual({ summary: "ok" });
+  });
+
+  it("reports a truncated reply clearly", async () => {
+    create.mockResolvedValue({
+      content: [{ type: "text", text: '{"summary":"cut' }],
+      stop_reason: "max_tokens",
+      usage: {},
+    });
+    await expect(generateDashaPrediction("prompt")).rejects.toThrow(/truncated/);
+  });
+});
