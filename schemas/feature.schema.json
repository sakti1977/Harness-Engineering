{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness feature ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "outcome",
    "state",
    "expected_surface",
    "exclusions",
    "verification",
    "claims"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "blocked",
        "ready_for_verification"
      ]
    },
    "expected_surface": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
